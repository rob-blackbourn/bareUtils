{
  "editor.rulers": [80, 120],
  "[python]": {
    "editor.wordBasedSuggestions": "off",
    "editor.formatOnSave": true
  },
  "python.defaultInterpreterPath": ".venv/bin/python",
  "cSpell.language": "en-US",
  "cSpell.words": [
    "afes",
    "apng",
    "ASGI",
    "asyncio",
    "Authorisation",
    "autodoc",
    "autopep",
    "avif",
    "bareasgi",
    "bareutils",
    "booleaness",
    "codehilite",
    "CORS",
    "Decompressor",
    "docstring",
    "dunder",
    "favicon",
    "ffwef",
    "fghij",
    "isdst",
    "jetblack",
    "klmno",
    "mday",
    "mkdocs",
    "mypy",
    "PHPSESSID",
    "pylint",
    "pytest",
    "Referer",
    "Rpbjpvc",
    "sessionid",
    "setuptools",
    "testpaths",
    "tzinfo",
    "UNPROCESSABLE",
    "WBITS",
    "wday",
    "webp",
    "yday"
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
}
